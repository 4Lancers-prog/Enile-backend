# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173
# Set to true behind HTTPS / a TLS-terminating proxy so cookies are Secure
COOKIE_SECURE=false
# Number of trusted proxy hops (load balancer). 0 when running directly.
TRUST_PROXY=0

# ---- Database (use a least-privilege user; replica set recommended for transactions) ----
MONGODB_URI=mongodb://localhost:27017/enile_crm?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=20

# ---- Auth secrets: generate with `openssl rand -hex 48`; never commit real values ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
FILE_URL_SECRET=change-me-file-link-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- File storage (private directory outside the web root) ----
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# ---- Frontend (optional) ----
# Path to the built frontend (enile-crm-frontend/dist). In production the API then serves the UI
# from the same origin, which the SameSite=Strict cookies need. Leave empty if a reverse proxy does it.
CLIENT_DIST_DIR=

# ---- Email (reminders). Leave SMTP_HOST empty to log emails instead of sending. ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Enile CRM <no-reply@enile.local>"
APP_BASE_URL=http://localhost:5173

# ---- Worker ----
WORKER_POLL_MS=5000
SCHEDULER_INTERVAL_MIN=60

# ---- Seed (first admin; change the password at first login) ----
SEED_ADMIN_EMAIL=admin@enile.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
LOG_LEVEL=info
